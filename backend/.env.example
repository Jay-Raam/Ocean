[TEMPLATE]
# Copy to .env and adjust. All values optional — defaults work without Mongo/Redis
# (the API then falls back to in-memory storage/cache and logs a warning).

# MongoDB (used when reachable; docker-compose provides a local instance)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ocean

# Redis cache (used when reachable)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Email notifications (optional — omit to disable)
# SMTP_HOST e.g. smtp.gmail.com / smtp.mailgun.org / smtp.sendgrid.net
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# "From" address (required for email notifications)
MAIL_FROM=
# Comma-separated recipients of booking requests (defaults to MAIL_FROM)
MAIL_TO=
# Also send a copy of each confirmation to the guest's email address
MAIL_GUEST_CONFIRM=false

# Webhook notifications (optional — POST the booking payload here)
WEBHOOK_URL=
